        "programming",
        "engineering",
        "cybersecurity"
      ],
      "providers": [
        {
          "sourceId": "internet_archive",
          "archiveQuery": "subject:computers"
        },
        {
          "sourceId": "arxiv",
          "arxivQuery": "cat:cs.AI"
        },
        {
          "sourceId": "openalex",
          "query": "computer science artificial intelligence"
        },
        {
          "sourceId": "wikipedia",
          "wikiCategory": "Technology"
        }
      ]
    },
