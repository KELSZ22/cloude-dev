  ],
  "downloadFlow": [
    "Load manifest and choose category.",
    "Call each selected providers discovery endpoint using URL-encoded category query fields. Never interpolate untrusted values without encoding.",
    "Normalize metadata into content records; de-duplicate by DOI, ISBN, or canonical URL.",
    "Fetch item details where necessary and resolve the actual downloadable PDF URL. A search result or webpage alone is not a PDF.",
    "Show citation, original link and license status; permit user download only when allowed and exposed by the provider.",
    "Download to app-private persistent storage with cancellation, resumable transfer when supported, size and MIME/PDF signature checks, and checksum verification.",
    "Extract text locally for offline keyword and vector indexing; preserve page numbers where extraction supports them.",
    "Store the file path, content metadata, source URL, license, attribution, checksum and revision for offline reading.",
    "On update, re-fetch metadata online and ask before replacing large downloaded assets."
  ],
  "recommendedKnowledgePackFormat": {
    "manifestFilename": "pack.json",
    "filesDirectory": "documents/",
    "indexDirectory": "index/",
    "fields": [
      "packId",
      "categoryId",
      "packVersion",
      "createdAt",
      "documents",
      "totalBytes",
      "attributions"
    ],
    "suggestedDocumentFields": [
      "id",
      "title",
      "sourceId",
      "sourcePageUrl",
      "localPath",
      "format",
      "sizeBytes",
      "sha256",
      "licenseName",
      "licenseUrl",
      "attribution",
      "language"
    ]
  },
  "sourcesLastDocumentationReview": "2026-10-09",
  "disclaimer": "Sample searches are starter filters; verify relevance and API responses at runtime. No actual downloadable items or PDF rights have been prevalidated by this manifest."
}
